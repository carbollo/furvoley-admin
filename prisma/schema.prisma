generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// --- AUTHENTICATION MODELS ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  mustChangePassword Boolean   @default(false) // Si true, fuerza al usuario a cambiar la contraseña en el próximo login
  role               String    @default("MEMBER") // ADMIN, COACH, TREASURER, MEMBER (PLAYER legacy)
  accounts           Account[]
  sessions           Session[]

  // Link to the club member profile
  memberId  String?    @unique
  member    Member?    @relation(fields: [memberId], references: [id])
  newsPosts NewsPost[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- CLUB MANAGEMENT MODELS ---

model Member {
  id                String    @id @default(cuid())
  name              String
  dni               String?
  birthDate         DateTime?
  email             String?
  phone             String?
  address           String?
  guardianName      String?
  guardianPhone     String?
  sportPreference   String? // Deporte/interés de inscripción (ej. antes de asignar equipo)
  /**
   * Valores de campos personalizados de registro (slug → texto).
   */
  registrationExtra Json?
  status            String    @default("ACTIVE") // LEAD, ACTIVE, PAUSED, INACTIVE, PENDING_PAYMENT
  /**
   * Cliente Stripe (cuenta conectada del club) para Checkout recurrente.
   */
  stripeCustomerId  String?
  joinedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User?
  payments          Payment[]
  attendances       Attendance[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  reminders         ReminderLog[]
  signupSubmissions SignupLink[]      @relation("SignupLinkCreatedMember")
  orders            Order[]
  leads             Lead[]
  groupMemberships  GroupMembership[]
  chatMessages      ChatMessage[]
}

// --- ORGANIGRAMA (grupos y subgrupos) ---

/// Grupo del organigrama. Sustituye progresivamente el concepto de "equipo":
/// estructura libre en árbol (grupo → subgrupos) por contención: un grupo
/// agrupa a sus miembros directos y a los de todos sus subgrupos.
model Group {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    Group?   @relation("GroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Group[]  @relation("GroupTree")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// JID del chat de WhatsApp del grupo (…@g.us), si se ha creado desde el
  /// organigrama. Su presencia es lo que habilita "Mensaje al grupo": con él,
  /// el mensaje va UNA vez al chat en vez de uno a uno a cada socio.
  whatsappGroupId        String?
  whatsappGroupCreatedAt DateTime?

  memberships  GroupMembership[]
  chatMessages ChatMessage[]
  events       Event[]

  @@index([parentId])
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  memberId  String
  role      String   @default("PLAYER") // PLAYER | COACH | FAMILY
  createdAt DateTime @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([memberId])
}

// --- CHAT (WhatsApp vía ApiWass) ---

/// Mensaje del módulo Chat. Historial local de las conversaciones del CRM:
/// hilos 1 a 1 (memberId) o de grupo del organigrama (groupId, difusión a los
/// miembros efectivos). direction IN queda reservado para webhooks entrantes.
model ChatMessage {
  id        String   @id @default(cuid())
  direction String   @default("OUT") // OUT | IN
  memberId  String?
  groupId   String?
  body      String   @db.Text
  status    String   @default("SENT") // SENT | PARTIAL | FAILED
  error     String?
  createdAt DateTime @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group  Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([groupId, createdAt])
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  sportPreference String?
  status          String   @default("NEW") // NEW, CONTACTED, TRIAL, CONVERTED, LOST
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model SignupLink {
  id        String    @id @default(cuid())
  token     String    @unique
  isActive  Boolean   @default(true)
  maxUses   Int       @default(1)
  usesCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdMemberId String?
  createdMember   Member? @relation("SignupLinkCreatedMember", fields: [createdMemberId], references: [id], onDelete: SetNull)
}

model Payment {
  id              String    @id @default(cuid())
  amount          Float
  month           Int // 1-12
  year            Int
  status          String    @default("PENDING") // PENDING, PAID
  stripeUrl       String?
  stripeSessionId String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MembershipPlan {
  id                          String   @id @default(cuid())
  name                        String   @unique
  description                 String?
  amount                      Float
  currency                    String   @default("EUR")
  billingPeriod               String   @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  enrollmentFee               Float    @default(0)
  /**
   * Si true, el socio queda en PENDING_PAYMENT hasta pagar la primera factura (alta).
   */
  paymentRequiredOnEnrollment Boolean  @default(false)
  /**
   * Día del mes en que se emite la cuota recurrente (1–28).
   */
  billingDayOfMonth           Int      @default(1)
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  subscriptions Subscription[]
  whopMapping   WhopPlanMapping?
}

/// Espejo de una cuota del CRM en la cuenta Whop del club: el plan de Whop se
/// pre-crea por API (a diferencia de Stripe, que generaba price_data al vuelo) y
/// aquí se guarda el vínculo. Un mapeo por cuota; al cambiar el precio se crea un
/// plan nuevo en Whop y se actualiza este registro (los planes Whop son inmutables).
/// Evento de cobro que llegó de la pasarela y NO se pudo conciliar con ninguna
/// factura (metadata ausente, factura anulada, moneda distinta…). Es la red de
/// seguridad del dinero: sin esto, un cobro sin destino se perdería en silencio
/// y el socio seguiría recibiendo reclamaciones de algo que ya pagó.
model WhopUnreconciledEvent {
  id         String    @id @default(cuid())
  eventType  String
  /// Id del pago en la pasarela (pay_…), si venía.
  externalId String?
  amount     Float?
  currency   String?
  reason     String
  /// Payload completo, para poder rehacer la conciliación a mano.
  payload    Json
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt])
  @@index([externalId])
}

/// Cada transferencia del saldo del club a su banco.
///
/// Se escribe ANTES de pedirla a la pasarela y con su clave de reintento ya
/// fijada: la clave es única en esta tabla, así que ni un reintento del cron ni
/// dos usuarios a la vez pueden generar dos transferencias del mismo barrido,
/// aunque la pasarela fallara en deduplicar. También es el registro con el que
/// el club sabe de qué es cada ingreso que le entra en el banco.
model WhopPayout {
  id             String    @id @default(cuid())
  /// Clave de reintento enviada a la pasarela. Estable por barrido: reintentar
  /// con ella repite la respuesta original en vez de mover el dinero otra vez.
  idempotencyKey String    @unique
  /// Id en la pasarela (po_…). Nulo mientras no se confirme.
  payoutId       String?   @unique
  amount         Float
  currency       String
  /// SENDING (pedida, sin confirmar) | SENT | FAILED | UNKNOWN (resultado
  /// indeterminado: hubo timeout y hay que comprobarlo antes de reintentar).
  status         String    @default("SENDING")
  /// AUTO (barrido programado) | MANUAL (botón del club).
  trigger        String    @default("AUTO")
  /// Motivo del fallo, en lenguaje que se le puede enseñar al club.
  error          String?
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model WhopPlanMapping {
  id                String   @id @default(cuid())
  /// Cuenta de la pasarela a la que pertenecen el producto y el plan. Si el club
  /// reconecta con OTRA cuenta, este mapeo deja de valer (cobraría en la cuenta
  /// antigua): se compara antes de reutilizarlo y se borra al reconectar.
  whopCompanyId     String
  whopProductId     String
  whopPlanId        String   @unique
  /// Snapshot del precio/periodo/moneda con el que se creó el plan (detecta drift).
  amount            Float
  currency          String   @default("EUR")
  billingPeriodDays Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  membershipPlanId String         @unique
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                          String    @id @default(cuid())
  status                      String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELED
  startDate                   DateTime  @default(now())
  endDate                     DateTime?
  nextInvoiceDate             DateTime
  autoPay                     Boolean   @default(false)
  /**
   * Hereda del plan si no se indica al asignar; exige pago al alta.
   */
  paymentRequiredOnEnrollment Boolean   @default(false)
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  /// Membership de Whop que renueva esta suscripción (mem_…). Es el vínculo que
  /// usa el webhook para emitir la factura del periodo cuando Whop cobra.
  whopMembershipId            String?   @unique
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  memberId       String
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId         String
  plan           MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  /**
   * Descuento aplicado a las facturas de esta suscripción (roadmap · 6.5).
   */
  discountCodeId String?
  discountCode   DiscountCode?  @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  invoices       Invoice[]

  @@index([discountCodeId])
}

/// Código de descuento (roadmap · 6.5): se genera aquí y se asocia a una
/// suscripción al crearla; cada factura emitida descuenta el % o importe fijo.
/// Tipos configurables vía etiqueta libre (hermanos, familia numerosa, etc.).
model DiscountCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  kind      String   @default("PERCENT") // PERCENT | FIXED
  value     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Invoice {
  id                    String    @id @default(cuid())
  invoiceNumber         String    @unique
  kind                  String    @default("MEMBERSHIP") // MEMBERSHIP, OTHER, CREDIT_NOTE
  /// Nota interna: por qué se anuló, o a qué factura rectifica. Queda en el
  /// libro, que es donde tiene que quedar.
  notes                 String?   @db.Text
  issueDate             DateTime  @default(now())
  dueDate               DateTime
  subtotal              Float
  taxAmount             Float     @default(0)
  /// Retención practicada. Antes se deducía restando (subtotal + IVA − total),
  /// y cualquier incoherencia se convertía en una «retención» que nadie había
  /// aplicado. Además hace falta guardada para poder asentar el devengo.
  withholdingAmount     Float     @default(0)
  totalAmount           Float
  paidAmount            Float     @default(0)
  currency              String    @default("EUR")
  status                String    @default("PENDING") // PENDING, OVERDUE, PARTIAL, PAID, VOID
  stripeCheckoutUrl     String?
  stripeSessionId       String?
  /// Enlace de pago de Whop cacheado para esta factura (checkout ch_…). El importe
  /// se guarda con él: un enlace ya emitido cobra SIEMPRE la cantidad con la que se
  /// creó, así que si la factura cambia (pago parcial, edición) hay que rehacerlo.
  whopCheckoutUrl       String?
  whopCheckoutId        String?
  whopCheckoutAmount    Float?
  /// Cuándo se abrió por última vez el enlace de pago de esta factura.
  ///
  /// El enlace se puede volver a abrir mientras el cobro no llega por webhook, y
  /// un socio impaciente pagaba dos veces la misma cuota. Con esta marca, la
  /// pantalla del socio le dice «pago en curso» durante unos minutos en vez de
  /// volver a ofrecerle el botón.
  whopCheckoutStartedAt DateTime?
  paidAt                DateTime?
  pdfStoredAt           DateTime? // última generación / descarga persistida (opcional)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberId        String
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  paymentAttempts PaymentAttempt[]
  reminders       ReminderLog[]
  order           Order?
  ledgerEntries   Transaction[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int      @default(1)
  unitAmount  Float
  totalAmount Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id                  String   @id @default(cuid())
  method              String   @default("WHOP") // WHOP, CASH, BANK_TRANSFER (STRIPE: histórico)
  status              String   @default("PENDING") // PENDING, SUCCEEDED, FAILED
  amount              Float
  stripePaymentIntent String?
  stripeSessionId     String?
  /// ID del pago en la pasarela (Whop: pay_…). Clave del dedupe del webhook:
  /// las entregas son at-least-once y recordInvoicePayment SUMA el importe. Es
  /// @unique para que la BD sea la garantía real (un check previo tiene carrera
  /// entre dos entregas simultáneas): el segundo intento choca con P2002.
  externalPaymentId   String?  @unique
  errorMessage        String?
  attemptedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ReminderLog {
  id           String   @id @default(cuid())
  reminderType String // D_MINUS_7, D_MINUS_2, D_PLUS_1, D_PLUS_7
  channel      String   @default("EMAIL") // EMAIL
  status       String   @default("SENT") // SENT, FAILED
  message      String?
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Workflow {
  id            String   @id @default(cuid())
  name          String
  description   String?
  triggerType   String
  triggerConfig Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps WorkflowStep[]
}

/// Plantillas guardadas en la biblioteca (subidas a mano o desde un flujo existente).
model WorkflowTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  triggerType   String
  triggerConfig Json?
  /// Pasos serializados: { position, stepType, actionType, config }[]
  steps         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkflowStep {
  id         String   @id @default(cuid())
  position   Int
  stepType   String
  actionType String
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, position])
}

/// Enlaces públicos con token para respuestas de workflows (pase de lista, convocatoria, etc.)
model WorkflowResponseToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      String // ATTENDANCE, ATTENDANCE_REASON, CONVOCATION, TRIAL, MATCH_RESULT, CONSENT, LEAVE_SURVEY, SEASON_RENEWAL
  memberId  String?
  eventId   String?
  groupId   String?
  payload   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([type, expiresAt])
}

model EventConvocation {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  status    String   @default("INVITED") // INVITED, CONFIRMED, DECLINED, NOT_CALLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId])
}

model GroupChangeRequest {
  id           String   @id @default(cuid())
  memberId     String
  fromGroupId  String?
  toGroupId    String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([memberId])
  @@index([status])
}

model CoachSubstitution {
  id                String   @id @default(cuid())
  eventId           String
  originalCoachId   String?
  substituteCoachId String
  status            String   @default("ASSIGNED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([eventId])
}

model MemberDocument {
  id        String    @id @default(cuid())
  memberId  String
  type      String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([memberId])
  @@index([expiresAt])
}

model PlayerEvaluation {
  id        String   @id @default(cuid())
  memberId  String
  groupId   String?
  summary   String?  @db.Text
  status    String   @default("DRAFT") // DRAFT, PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

model CoachIncident {
  id         String   @id @default(cuid())
  coachId    String
  title      String
  resolution String?  @db.Text
  status     String   @default("OPEN") // OPEN, RESOLVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DiscountRule {
  id        String   @id @default(cuid())
  name      String
  ruleType  String // SIBLING, STAFF_CHILD, PERCENT
  percent   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberCreditBalance {
  id        String   @id @default(cuid())
  memberId  String   @unique
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt
}

model Transaction {
  id            String   @id @default(cuid())
  type          String // INCOME, EXPENSE
  amount        Float
  description   String
  date          DateTime @default(now())
  bankReference String? // referencia bancaria / concepto del extracto
  source        String   @default("MANUAL") // MANUAL, STRIPE, BANK_TRANSFER, CASH, INVOICE_PAYMENT, BANK_CSV_IMPORT
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankMatches BankStatementLine[]
}

model AccountChart {
  id         String   @id @default(cuid())
  code       String   @unique // PGC code (e.g. 4300001, 7000000)
  name       String
  level      Int // 1..5
  nature     String // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  isActive   Boolean  @default(true)
  parentCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines JournalLine[]

  @@index([code])
  @@index([nature])
}

model FiscalPeriod {
  id        String   @id @default(cuid())
  code      String   @unique // YYYY-MM
  startsAt  DateTime
  endsAt    DateTime
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries JournalEntry[]
}

model JournalEntry {
  id           String   @id @default(cuid())
  entryNumber  String   @unique
  concept      String
  entryDate    DateTime
  reference    String?
  status       String   @default("POSTED") // DRAFT, POSTED, REVERSED
  source       String   @default("MANUAL") // MANUAL, INVOICE, PAYMENT, ADJUSTMENT, SYSTEM
  sourceId     String?
  reversalOfId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  lines          JournalLine[]
}

model JournalLine {
  id          String   @id @default(cuid())
  side        String // DEBIT, CREDIT
  amount      Float
  lineConcept String?
  memberId    String?
  costCenter  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   AccountChart @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId, side])
  @@index([accountId])
}

model BankImport {
  id             String   @id @default(cuid())
  fileName       String?
  importedAt     DateTime @default(now())
  rowCount       Int      @default(0)
  note           String?
  /// Avisos del importador (filas omitidas, columnas no reconocidas…). Antes se
  /// mostraban una sola vez y se perdían al navegar al detalle, así que el
  /// tesorero no volvía a saber que faltaban filas.
  warnings       Json?
  /// Cuántas filas se descartaron por venir ya en un extracto anterior.
  duplicateCount Int      @default(0)

  lines BankStatementLine[]
}

model BankStatementLine {
  id                   String       @id @default(cuid())
  bankImportId         String
  bankImport           BankImport   @relation(fields: [bankImportId], references: [id], onDelete: Cascade)
  rowIndex             Int
  date                 DateTime
  signedAmount         Float // >0 ingreso en cuenta del club, <0 cargo
  description          String       @db.Text
  reference            String?
  status               String       @default("PENDING") // PENDING, MATCHED, IGNORED, NEW_LEDGER
  matchedTransactionId String?
  matchedTransaction   Transaction? @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  /// Huella de la fila (fecha + importe + concepto normalizado). Es @unique para
  /// que volver a subir el mismo extracto NO duplique los ingresos: la fila
  /// repetida choca contra el índice y se descarta, en vez de contarse dos veces.
  fingerprint          String?      @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status])
}

// --- TEAMS AND PLANNING MODELS ---

/// Categoría deportiva definida por edad (no por año de nacimiento fijo), de modo
/// que el rango de años se recalcula solo cada temporada. Ej.: "Infantil" minAge 12,
/// maxAge 13 → siempre los nacidos hace 12-13 años respecto al año actual.
model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  minAge         Int? // edad mínima (años). null = sin mínimo
  maxAge         Int? // edad máxima (años). null = sin máximo
  defaultGroupId String? // grupo por defecto al que asignar los socios de esta categoría
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
}

model ClubHoliday {
  id        String   @id @default(cuid())
  date      DateTime
  name      String?
  createdAt DateTime @default(now())
}

model Event {
  id           String    @id @default(cuid())
  title        String
  type         String // TRAINING, MATCH, TOURNAMENT, SOCIAL, OTHER
  date         DateTime
  endDate      DateTime? // Optional end date for multi-day tournaments or events
  location     String?
  description  String?   @db.Text
  isPublic     Boolean   @default(false) // If true, anyone can see it
  maxAttendees Int? // Capacity limit
  price        Float? // Cost to attend, if any
  status       String    @default("SCHEDULED") // SCHEDULED, CANCELLED, COMPLETED
  source       String    @default("MANUAL") // MANUAL
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Formulario de asistencia programado: se envía por WhatsApp N días antes del
  // evento (attendanceReminderDays), lo dispara el cron /api/jobs/attendance-forms.
  // attendanceFormSentAt != null ⇒ ya enviado (evita reenvíos).
  attendanceFormEnabled  Boolean   @default(false)
  attendanceReminderDays Int? // 1, 3, 7, 15 o 30
  attendanceFormSentAt   DateTime?

  groupId String? // Optional: if null, it's a club-wide event
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  attendances    Attendance[]
  guestAttendees EventGuestAttendee[]
}

/// Inscripción de no socios desde la ficha pública del evento (una fila = una entrada)
model EventGuestAttendee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  dni       String
  phone     String? // obligatorio solo en el titular (primera entrada); acompañantes sin teléfono
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, dni])
  @@index([eventId])
}

model Attendance {
  id        String   @id @default(cuid())
  status    String // PRESENT, ABSENT, INJURED, PENDING
  reason    String? // Reason for absence
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

// --- TRAINING / ENTRENAMIENTO MODELS ---
// Módulo de entrenamiento (estilo 360Player), construido con nuestro código:
// jerarquía Colección → Sesión → Bloque → Ejercicio. Cada ejercicio guarda un
// diagrama de pizarra táctica en `diagram` (Json): tipo de campo + fichas +
// diapositivas con posiciones normalizadas (0..1) para animar el movimiento de
// las fichas al pasar de una diapositiva a la siguiente.
// Datos POR-TENANT: viven en la BD tenant_<slug> y se acceden con el proxy `prisma`.

model TrainingCollection {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  courtType   String   @default("volleyball") // volleyball, football, futsal, basketball, tennis, handball, blank
  tags        String? // etiquetas separadas por coma
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions TrainingSession[]

  @@index([name])
}

model TrainingSession {
  id          String   @id @default(cuid())
  title       String
  objective   String?  @db.Text
  tags        String? // etiquetas separadas por coma
  durationMin Int? // duración total en minutos (informativa)
  groupId     String? // equipo asociado (referencia suelta a Group.id; sin relación FK)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collectionId String?
  collection   TrainingCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  blocks TrainingBlock[]

  @@index([collectionId])
}

model TrainingBlock {
  id          String   @id @default(cuid())
  name        String
  durationMin Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exercises TrainingExercise[]

  @@index([sessionId])
}

model TrainingExercise {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  durationMin Int?
  players     Int?
  courtType   String   @default("volleyball") // volleyball, football, futsal, basketball, tennis, handball, blank
  diagram     Json? // { courtType, transitionMs, tokens:[{id,kind,label}], slides:[{id,positions:{[tokenId]:{x,y}}}] }
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blockId String
  block   TrainingBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
}

// --- STORE & PRODUCTS MODELS ---

model Product {
  id                 String   @id @default(cuid())
  name               String
  description        String?  @db.Text
  price              Float
  stock              Int      @default(0)
  image              String?
  category           String?
  /// Tipo de cobro (roadmap · 6.4): ONE_TIME (pago único) | SUBSCRIPTION (recurrente).
  type               String   @default("ONE_TIME")
  /// Solo SUBSCRIPTION: periodicidad del cobro (MONTHLY, QUARTERLY, YEARLY).
  billingPeriod      String?
  /// Solo SUBSCRIPTION: plan de cuota vinculado que ejecuta el cobro recurrente.
  subscriptionPlanId String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  status          String   @default("PENDING") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  totalAmount     Float
  customerName    String
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?  @db.Text
  shippingNotes   String?  @db.Text
  trackingNumber  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  items     OrderItem[]
  invoiceId String?     @unique
  invoice   Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model TaxConfig {
  id                      String   @id @default(cuid())
  isDefault               Boolean  @default(true)
  vatRateIncome           Float    @default(21)
  vatRateExpense          Float    @default(21)
  withholdRateIncome      Float    @default(0)
  withholdRateExpense     Float    @default(0)
  applyOnInvoices         Boolean  @default(true)
  applyOnIncome           Boolean  @default(true)
  applyOnExpense          Boolean  @default(true)
  applyWithholdOnInvoices Boolean  @default(false)
  applyWithholdOnIncome   Boolean  @default(false)
  applyWithholdOnExpense  Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([isDefault])
}

model WhatsAppConfig {
  id              String   @id @default(cuid())
  isDefault       Boolean  @default(true)
  linkedSessionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([isDefault])
}

// --- META ADS INTEGRATION MODELS ---

model MetaConfig {
  id          String   @id @default(cuid())
  accessToken String   @db.Text
  adAccountId String
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MetaCampaign {
  id             String  @id @default(cuid())
  campaignId     String  @unique // ID from Meta Graph API
  name           String
  status         String // ACTIVE, PAUSED, DELETED, ARCHIVED
  objective      String?
  dailyBudget    Float?
  lifetimeBudget Float?

  // Metrics (cached from Insights API)
  spend       Float @default(0)
  impressions Int   @default(0)
  clicks      Int   @default(0)
  reach       Int   @default(0)

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NewsPost {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  isPublished Boolean   @default(false)
  priority    String    @default("NORMAL") // HIGH, NORMAL
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

// --- CLUB IDENTITY & SUBSCRIPTION (singleton) ---
model ClubSettings {
  id                       String  @id @default(cuid())
  isDefault                Boolean @default(true)
  // Identidad
  name                     String  @default("Furvoley")
  logoUrl                  String? @db.Text // data URL (base64) o URL externa
  // Información legal
  legalName                String?
  taxId                    String? // CIF / NIF / VAT
  address                  String?
  city                     String?
  postalCode               String?
  province                 String?
  country                  String? @default("España")
  contactEmail             String?
  contactPhone             String?
  website                  String?
  // Marca
  primaryColor             String? // hex (#004ac6, etc.)
  // Plantilla del PDF de facturas (valor: CLASSIC | MODERN | COMPACT)
  invoicePdfTemplate       String  @default("CLASSIC")
  /**
   * Definición de campos visibles en inscripción (enlace + alta CRM).
   */
  registrationFieldsConfig Json?
  // NOTA: la configuración de Stripe (customer ID + dashboard URL) vive en
  // variables de entorno (Railway): STRIPE_CLUB_CUSTOMER_ID y STRIPE_DASHBOARD_URL.

  // --- Stripe Connect Express (onboarding desde el CRM) ---
  // El admin del club puede pulsar "Conectar mi cuenta de Stripe" y completar
  // un onboarding hospedado por Stripe. El acct_… se persiste aquí. La env var
  // STRIPE_CONNECTED_ACCOUNT_ID (Railway) sigue siendo válida como override
  // con prioridad máxima. Tipo siempre 'express'.
  stripeConnectedAccountId String?
  stripeAccountType        String?   @default("express")
  stripeChargesEnabled     Boolean?  @default(false)
  stripePayoutsEnabled     Boolean?  @default(false)
  stripeDetailsSubmitted   Boolean?  @default(false)
  stripeAccountStatusAt    DateTime?

  // --- Whop (pasarela de cobro del club; sustituye a Stripe) ---
  /// Company de Whop del club (biz_…). La crea el CRM por API al configurar la
  /// pasarela; el club nunca entra en whop.com salvo para el KYC alojado.
  whopCompanyId          String?
  /// API key de esa company (creada por API desde la cuenta plataforma). Secreta:
  /// nunca se devuelve al cliente, solo se usa en el servidor.
  whopApiKey             String?   @db.Text
  /// Secret del webhook registrado para este club (verificación HMAC del payload).
  whopWebhookSecret      String?   @db.Text
  /// Estado del onboarding: NONE | PENDING_KYC | PENDING_BANK | READY | DISABLED
  whopOnboardingStatus   String?   @default("NONE")
  whopChargesEnabled     Boolean?  @default(false)
  whopPayoutsEnabled     Boolean?  @default(false)
  /// Método de payout (banco del club, potk_…) al que el CRM transfiere el saldo.
  whopPayoutMethodId     String?
  /// Divisa en la que esa cuenta recibe el dinero. El barrido automático sólo
  /// transfiere saldo de esta divisa: mandar otra implicaría un cambio de moneda
  /// al tipo del día, y eso lo decide el club a mano.
  whopPayoutCurrency     String?   @default("EUR")
  whopAccountStatusAt    DateTime?
  /// Auto-transferencia del saldo al banco del club: OFF | DAILY | WEEKLY | MONTHLY.
  whopSweepFrequency     String?   @default("WEEKLY")
  /// Importe mínimo (EUR) para lanzar la transferencia automática.
  whopSweepMinAmount     Float?    @default(10)
  whopLastSweepAt        DateTime?
  /// Cerrojo del barrido: mientras esté puesto (y no caducado) ningún otro
  /// proceso puede lanzar transferencias de este club. Evita que dos pestañas,
  /// dos usuarios o el cron y el botón manual muevan el dinero a la vez.
  whopSweepLockAt        DateTime?
  /// El tesorero puede lanzar transferencias del saldo al banco. El ADMIN puede
  /// revocárselo. Se comprueba en el SERVIDOR, no solo ocultando el botón: si
  /// solo se ocultara, seguiría bastando una llamada desde la consola.
  treasurerCanTransfer   Boolean   @default(true)
  /// Tope de gasto que se aplica a una tarjeta nueva cuando el ADMIN no indica
  /// otro, y cada cuánto. En dólares, que es la divisa en la que liquida la
  /// tarjeta. `null` significa «sin tope», y hay que elegirlo a propósito.
  cardDefaultLimit       Float?    @default(500)
  cardDefaultLimitPeriod String?   @default("monthly")

  /**
   * API key para Hermes Agent MCP (Bearer). Env HERMES_MCP_API_KEY tiene prioridad.
   */
  hermesMcpApiKey        String? @db.Text
  /**
   * Bearer interno para el API Server de Hermes (chat web CRM). Env HERMES_API_SERVER_KEY tiene prioridad.
   */
  hermesApiServerKey     String? @db.Text
  hermesEnabled          Boolean @default(false)
  /**
   * LLM provider activo: ollama-cloud | deepseek
   */
  hermesModelProvider    String  @default("ollama-cloud")
  hermesOllamaApiKey     String? @db.Text
  hermesOllamaModel      String? @default("gpt-oss:120b")
  hermesDeepseekApiKey   String? @db.Text
  hermesDeepseekModel    String? @default("deepseek-chat")
  hermesWhatsappMode     String? @default("bot")
  hermesAllowedUsers     Json?
  hermesAllowDestructive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([isDefault])
}

/// Quién ha visto el número completo de una tarjeta.
///
/// Vive en la BD del propio club para que su administración pueda revisarlo sin
/// depender del proveedor del CRM. Guarda a la persona, no el dato: aquí no hay
/// ni un dígito del número de tarjeta.
///
/// Por decisión de producto, las consultas hechas por el proveedor del CRM
/// mientras impersona NO se registran aquí; quedan en la auditoría del portal
/// central, que es donde consta también el motivo de la impersonación.
model CardViewLog {
  id        String   @id @default(cuid())
  /// Identificador de la tarjeta en la pasarela (icrd_…). Nunca el número.
  cardId    String
  /// Últimos cuatro, para que la administración reconozca la tarjeta.
  cardLast4 String?
  userId    String?
  userName  String?
  userEmail String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([cardId])
}

/// Contador de peticiones por clave y ventana, para los límites de uso.
///
/// En base de datos y no en memoria a propósito: un contador en memoria se
/// reinicia con cada despliegue y no cruza instancias, así que quien conozca
/// esas dos cosas lo esquiva. Aquí el contador sobrevive al reinicio y es el
/// mismo para todo el mundo. Se incrementa con una sola sentencia atómica, de
/// modo que dos peticiones simultáneas no pueden colarse ambas.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model HermesMcpAuditLog {
  id             String   @id @default(cuid())
  toolName       String
  argsSummary    String   @db.Text
  memberId       String?
  /// Quién le pidió la acción al agente (teléfono de WhatsApp, normalmente).
  /// Sin esto el registro decía QUÉ se hizo pero no DE PARTE DE QUIÉN.
  actor          String?
  /// Conversación MCP, para reconstruir la secuencia completa.
  conversationId String?
  success        Boolean
  errorMessage   String?  @db.Text
  source         String   @default("hermes-mcp")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([toolName])
}

/// Registro de errores de ESTE club. Se agrupa por `fingerprint` (huella del
/// error normalizado) para no inundar: un mismo fallo repetido incrementa
/// `count` y actualiza `lastSeenAt` en vez de crear filas nuevas. Los campos de
/// actor (userId/memberId) van sueltos, sin FK: un error puede referirse a algo
/// ya borrado y el log no debe acoplarse ni sufrir cascadas.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  level       String   @default("ERROR") // WARN | ERROR | FATAL
  source      String // onRequestError | cron:snapshot | workflow:whatsapp | unhandledRejection …
  name        String? // clase del error (TypeError, PrismaClientKnownRequestError…)
  message     String   @db.Text
  stack       String?  @db.Text
  digest      String? // digest de Next para correlacionar
  route       String?
  method      String?
  routeType   String? // render | route | action | proxy
  context     Json?
  userId      String?
  userEmail   String?
  memberId    String?
  count       Int      @default(1)
  resolved    Boolean  @default(false)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([level])
  @@index([resolved])
}

// --- PORTAL CENTRAL (multi-tenant · Modelo C) ---
// Estas tablas viven en la BD del PORTAL (servicio con PORTAL_CENTRAL_HOST=true
// y su propia DATABASE_URL). En las BDs de cada cliente quedan vacías/sin uso.

/// Un cliente = su subdominio + su base de datos `tenant_<slug>`.
model Tenant {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  status   String @default("ACTIVE") // ACTIVE | SUSPENDED
  /// Módulos activados del CRM (mapa moduleId → bool). Ausente/null = todos
  /// activados. Permite vender planes distintos sin desplegar nada.
  features Json?

  // --- Plan y facturación del cliente (lo que paga al SaaS) ---
  /// Plan comercial asignado (opcional). Al asignarlo se derivan features/precio/límite.
  planId       String?
  plan         Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// Precio efectivo mensual del cliente (del plan o ajustado a mano). Base del MRR.
  priceMonthly Float?
  /// Si está y es futura, el club está en PRUEBA; al caducar el cron lo suspende.
  trialEndsAt  DateTime?
  /// Límite de socios (del plan). null = sin límite.
  memberLimit  Int?

  /// Company de Whop del club (biz_…): permite que el webhook ÚNICO de la cuenta
  /// plataforma resuelva a qué tenant pertenece cada evento (company → club) y
  /// ejecute la conciliación dentro de withTenant. Se fija al configurar la pasarela.
  whopCompanyId String? @unique

  /// Notas internas de soporte (solo visibles en el panel del portal).
  notes String?
  /// Etiquetas internas (VIP, moroso, migración…). La etiqueta `no-suspender`
  /// excluye al club del cron trial-suspend.
  tags  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users PortalUser[]

  @@index([status])
  @@index([planId])
}

/// Usuario dado de alta desde el panel del portal. Es la cuenta con la que se
/// entra al CRM de su tenant (rol con el que se crea al hacer SSO).
model PortalUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN") // rol en el CRM del tenant
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

/// Foto agregada de KPIs de TODOS los clubes, para el dashboard del super-admin.
/// La ESCRIBE el cron del CRM (crm-mt, único con acceso a las BD de tenant) con
/// un pg Client directo; la LEE el portal con prisma. Se guarda una fila por
/// pasada (histórico para las gráficas de tendencia). Los agregados globales van
/// en columnas; el desglose por club en `perClub` (JSON).
model PortalKpiSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  clubsTotal    Int @default(0)
  clubsActive   Int @default(0)
  tenantsOk     Int @default(0) // clubes cuya agregación fue bien
  tenantsFailed Int @default(0)

  membersTotal   Int @default(0)
  membersActive  Int @default(0)
  membersOverdue Int @default(0)

  incomeMonthTotal   Float @default(0) // ingresos del mes en curso, sumados
  pendingCount       Int   @default(0) // nº de cobros pendientes
  pendingAmountTotal Float @default(0)

  /// [{ slug, name, ok, error?, membersTotal, membersActive, membersOverdue,
  ///    incomeMonth, pendingCount, pendingAmount }]
  perClub Json

  @@index([createdAt])
}

/// Bandeja CENTRAL de errores graves de todos los clubes, para el super-admin.
/// La ESCRIBE crm-mt con un pg Client directo (nunca prisma) cuando un error de
/// nivel ERROR/FATAL ocurre en un club; la LEE el portal. Dedup por club+huella
/// (@@unique) → un mismo fallo repetido en el mismo club incrementa `count`.
model PortalErrorLog {
  id          String   @id @default(cuid())
  tenantSlug  String
  tenantName  String?
  fingerprint String // misma huella que en el club (única POR club, no global)
  level       String   @default("ERROR") // ERROR | FATAL
  source      String
  name        String?
  message     String   @db.Text
  route       String?
  stack       String?  @db.Text
  context     Json?
  count       Int      @default(1)
  resolved    Boolean  @default(false)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantSlug, fingerprint])
  @@index([tenantSlug, lastSeenAt])
  @@index([level])
  @@index([resolved])
}

/// Registro de acciones sensibles del super-admin (suspender/reactivar un club,
/// entrar como su admin, crear clientes/usuarios…). Lo escribe y lee el portal.
/// El actor es la sesión de PORTAL_ADMIN_PASSWORD (anónima), así que se guarda
/// como constante 'super-admin' + la IP para tener algo de trazabilidad.
model PortalAuditLog {
  id         String   @id @default(cuid())
  actor      String   @default("super-admin")
  action     String // SUSPEND | REACTIVATE | IMPERSONATE | CREATE_CLIENT | CREATE_USER | DISABLE_USER | ENABLE_USER | RESET_PASSWORD
  tenantSlug String?
  tenantName String?
  targetType String? // TENANT | PORTAL_USER
  targetId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantSlug, createdAt])
  @@index([action])
}

/// Plan comercial EDITABLE por el super-admin: agrupa módulos incluidos + precio
/// mensual + límite de socios. Asignar un plan a un club deriva sus features
/// (los módulos no incluidos se desactivan), su priceMonthly y su memberLimit.
model Plan {
  id            String   @id @default(cuid())
  name          String
  priceMonthly  Float    @default(0)
  /// Lista de moduleId incluidos (CrmModuleId[]). Vacío = ningún módulo opcional.
  modules       Json     @default("[]")
  memberLimit   Int? // null = ilimitado
  /// Token del webhook de alta automática desde una tienda externa. La URL
  /// `/api/portal-central/webhooks/subscription/<token>` da de alta un club nuevo
  /// con este plan. null = webhook no generado todavía.
  webhookToken  String?  @unique
  /// Secreto HMAC (opcional) para firmar el cuerpo del webhook. Si está, el handler
  /// EXIGE una firma HMAC-SHA256 válida del payload; si es null, no se exige firma.
  webhookSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants Tenant[]

  @@index([name])
}

/// Super-admin del portal con login propio (email + contraseña). Coexiste con la
/// contraseña maestra de entorno (PORTAL_ADMIN_PASSWORD), que nunca se elimina.
model PortalAdmin {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  name                  String?
  status                String    @default("ACTIVE") // ACTIVE | DISABLED
  lastLoginAt           DateTime?
  /// Sesiones (cookies HMAC) emitidas ANTES de esta fecha se rechazan. Se pone a
  /// `now()` al resetear la contraseña para expulsar sesiones robadas.
  sessionsInvalidBefore DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Ajustes clave/valor del portal, editables desde el panel (una fila por ajuste).
/// p. ej. `profit_split` = { selfPct, selfLabel, otherLabel } para el reparto de
/// beneficios del dashboard. `value` es JSON libre.
model PortalSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

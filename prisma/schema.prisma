generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// --- AUTHENTICATION MODELS ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  mustChangePassword Boolean @default(false) // Si true, fuerza al usuario a cambiar la contraseña en el próximo login
  role          String    @default("MEMBER") // ADMIN, COACH, TREASURER, MEMBER (PLAYER legacy)
  accounts      Account[]
  sessions      Session[]

  // Link to the club member profile
  memberId      String?   @unique
  member        Member?   @relation(fields: [memberId], references: [id])
  newsPosts     NewsPost[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- CLUB MANAGEMENT MODELS ---

model Member {
  id        String    @id @default(cuid())
  name      String
  dni       String?
  birthDate DateTime?
  email     String?
  phone     String?
  address   String?
  guardianName  String?
  guardianPhone String?
  sportPreference String? // Deporte/interés de inscripción (ej. antes de asignar equipo)
  /** Valores de campos personalizados de registro (slug → texto). */
  registrationExtra Json?
  status    String    @default("ACTIVE") // LEAD, ACTIVE, PAUSED, INACTIVE, PENDING_PAYMENT
  /** Cliente Stripe (cuenta conectada del club) para Checkout recurrente. */
  stripeCustomerId String?
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User?
  payments  Payment[]
  teamRoles TeamMember[]
  attendances Attendance[]
  subscriptions Subscription[]
  invoices Invoice[]
  reminders ReminderLog[]
  signupSubmissions SignupLink[] @relation("SignupLinkCreatedMember")
  orders    Order[]
  leads     Lead[]
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  sportPreference String?
  status          String   @default("NEW") // NEW, CONTACTED, TRIAL, CONVERTED, LOST
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model SignupLink {
  id              String   @id @default(cuid())
  token           String   @unique
  isActive        Boolean  @default(true)
  maxUses         Int      @default(1)
  usesCount       Int      @default(0)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdMemberId String?
  createdMember   Member?  @relation("SignupLinkCreatedMember", fields: [createdMemberId], references: [id], onDelete: SetNull)
}

model Payment {
  id              String   @id @default(cuid())
  amount          Float
  month           Int      // 1-12
  year            Int
  status          String   @default("PENDING") // PENDING, PAID
  stripeUrl       String?
  stripeSessionId String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MembershipPlan {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  amount          Float
  currency        String   @default("EUR")
  billingPeriod   String   @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  enrollmentFee   Float    @default(0)
  /** Si true, el socio queda en PENDING_PAYMENT hasta pagar la primera factura (alta). */
  paymentRequiredOnEnrollment Boolean @default(false)
  /** Día del mes en que se emite la cuota recurrente (1–28). */
  billingDayOfMonth Int @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id                    String   @id @default(cuid())
  status                String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELED
  startDate             DateTime @default(now())
  endDate               DateTime?
  nextInvoiceDate       DateTime
  autoPay               Boolean  @default(false)
  /** Hereda del plan si no se indica al asignar; exige pago al alta. */
  paymentRequiredOnEnrollment Boolean @default(false)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  memberId              String
  member                Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId                String
  plan                  MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices              Invoice[]
}

model Invoice {
  id                  String   @id @default(cuid())
  invoiceNumber       String   @unique
  kind                String   @default("MEMBERSHIP") // MEMBERSHIP, OTHER
  issueDate           DateTime @default(now())
  dueDate             DateTime
  subtotal            Float
  taxAmount           Float    @default(0)
  totalAmount         Float
  paidAmount          Float    @default(0)
  currency            String   @default("EUR")
  status              String   @default("PENDING") // PENDING, OVERDUE, PARTIAL, PAID, VOID
  stripeCheckoutUrl   String?
  stripeSessionId     String?
  paidAt              DateTime?
  pdfStoredAt         DateTime? // última generación / descarga persistida (opcional)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberId            String
  member              Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items               InvoiceItem[]
  paymentAttempts     PaymentAttempt[]
  reminders           ReminderLog[]
  order               Order?
  ledgerEntries       Transaction[]
}

model InvoiceItem {
  id            String   @id @default(cuid())
  description   String
  quantity      Int      @default(1)
  unitAmount    Float
  totalAmount   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id                  String   @id @default(cuid())
  method              String   @default("STRIPE") // STRIPE, CASH, BANK_TRANSFER
  status              String   @default("PENDING") // PENDING, SUCCEEDED, FAILED
  amount              Float
  stripePaymentIntent String?
  stripeSessionId     String?
  errorMessage        String?
  attemptedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ReminderLog {
  id                String   @id @default(cuid())
  reminderType      String   // D_MINUS_7, D_MINUS_2, D_PLUS_1, D_PLUS_7
  channel           String   @default("EMAIL") // EMAIL
  status            String   @default("SENT") // SENT, FAILED
  message           String?
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberId          String
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Workflow {
  id            String         @id @default(cuid())
  name          String
  description   String?
  triggerType   String
  triggerConfig Json?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  steps         WorkflowStep[]
}

/// Plantillas guardadas en la biblioteca (subidas a mano o desde un flujo existente).
model WorkflowTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  triggerType   String
  triggerConfig Json?
  /// Pasos serializados: { position, stepType, actionType, config }[]
  steps         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkflowStep {
  id          String    @id @default(cuid())
  position    Int
  stepType    String
  actionType  String
  config      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, position])
}

/// Enlaces públicos con token para respuestas de workflows (pase de lista, convocatoria, etc.)
model WorkflowResponseToken {
  id         String    @id @default(cuid())
  token      String    @unique
  type       String    // ATTENDANCE, ATTENDANCE_REASON, CONVOCATION, TRIAL, MATCH_RESULT, CONSENT, LEAVE_SURVEY, SEASON_RENEWAL
  memberId   String?
  eventId    String?
  teamId     String?
  payload    Json?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([type, expiresAt])
}

model EventConvocation {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  status    String   @default("INVITED") // INVITED, CONFIRMED, DECLINED, NOT_CALLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId])
}

model TeamChangeRequest {
  id           String    @id @default(cuid())
  memberId     String
  fromTeamId   String?
  toTeamId     String
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([memberId])
  @@index([status])
}

model CoachSubstitution {
  id               String   @id @default(cuid())
  eventId          String
  originalCoachId  String?
  substituteCoachId String
  status           String   @default("ASSIGNED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([eventId])
}

model MemberDocument {
  id        String   @id @default(cuid())
  memberId  String
  type      String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([expiresAt])
}

model PlayerEvaluation {
  id        String   @id @default(cuid())
  memberId  String
  teamId    String?
  summary   String?  @db.Text
  status    String   @default("DRAFT") // DRAFT, PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

model CoachIncident {
  id         String   @id @default(cuid())
  coachId    String
  title      String
  resolution String?  @db.Text
  status     String   @default("OPEN") // OPEN, RESOLVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DiscountRule {
  id        String   @id @default(cuid())
  name      String
  ruleType  String   // SIBLING, STAFF_CHILD, PERCENT
  percent   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberCreditBalance {
  id        String   @id @default(cuid())
  memberId  String   @unique
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt
}

model Transaction {
  id            String   @id @default(cuid())
  type          String   // INCOME, EXPENSE
  amount        Float
  description   String
  date          DateTime @default(now())
  bankReference String?  // referencia bancaria / concepto del extracto
  source        String   @default("MANUAL") // MANUAL, STRIPE, BANK_TRANSFER, CASH, INVOICE_PAYMENT, BANK_CSV_IMPORT
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankMatches   BankStatementLine[]
}

model AccountChart {
  id          String   @id @default(cuid())
  code        String   @unique // PGC code (e.g. 4300001, 7000000)
  name        String
  level       Int      // 1..5
  nature      String   // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  isActive    Boolean  @default(true)
  parentCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines       JournalLine[]

  @@index([code])
  @@index([nature])
}

model FiscalPeriod {
  id          String   @id @default(cuid())
  code        String   @unique // YYYY-MM
  startsAt    DateTime
  endsAt      DateTime
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     JournalEntry[]
}

model JournalEntry {
  id              String   @id @default(cuid())
  entryNumber     String   @unique
  concept         String
  entryDate       DateTime
  reference       String?
  status          String   @default("POSTED") // DRAFT, POSTED, REVERSED
  source          String   @default("MANUAL") // MANUAL, INVOICE, PAYMENT, ADJUSTMENT, SYSTEM
  sourceId        String?
  reversalOfId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fiscalPeriodId  String
  fiscalPeriod    FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  lines           JournalLine[]
}

model JournalLine {
  id            String   @id @default(cuid())
  side          String   // DEBIT, CREDIT
  amount        Float
  lineConcept   String?
  memberId      String?
  costCenter    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entryId       String
  entry         JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId     String
  account       AccountChart @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId, side])
  @@index([accountId])
}

model BankImport {
  id         String   @id @default(cuid())
  fileName   String?
  importedAt DateTime @default(now())
  rowCount   Int      @default(0)
  note       String?

  lines      BankStatementLine[]
}

model BankStatementLine {
  id                   String   @id @default(cuid())
  bankImportId         String
  bankImport           BankImport @relation(fields: [bankImportId], references: [id], onDelete: Cascade)
  rowIndex             Int
  date                 DateTime
  signedAmount         Float    // >0 ingreso en cuenta del club, <0 cargo
  description          String   @db.Text
  reference            String?
  status               String   @default("PENDING") // PENDING, MATCHED, IGNORED, NEW_LEDGER
  matchedTransactionId String?
  matchedTransaction   Transaction? @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// --- TEAMS AND PLANNING MODELS ---

model Team {
  id              String       @id @default(cuid())
  name            String
  category        String?      // e.g., "U12", "Senior"
  seasonStartDate DateTime?
  seasonEndDate   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members     TeamMember[]
  events      Event[]
  schedules   TeamSchedule[]
}

model TeamSchedule {
  id              String   @id @default(cuid())
  weekday         Int      // 0=domingo … 6=sábado
  startTime       String   // HH:mm
  durationMinutes Int      @default(90)
  title           String?
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, weekday])
}

model ClubHoliday {
  id        String   @id @default(cuid())
  date      DateTime
  name      String?
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  role      String   @default("PLAYER") // PLAYER, COACH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
}

model Event {
  id            String       @id @default(cuid())
  title         String
  type          String       // TRAINING, MATCH, TOURNAMENT, SOCIAL, OTHER
  date          DateTime
  endDate       DateTime?    // Optional end date for multi-day tournaments or events
  location      String?
  description   String?      @db.Text
  isPublic      Boolean      @default(false) // If true, anyone can see it
  maxAttendees  Int?         // Capacity limit
  price         Float?       // Cost to attend, if any
  status        String       @default("SCHEDULED") // SCHEDULED, CANCELLED, COMPLETED
  source        String       @default("MANUAL") // MANUAL | TEAM_SCHEDULE
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  teamId        String?      // Optional: if null, it's a club-wide event
  team          Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  attendances   Attendance[]
  guestAttendees EventGuestAttendee[]
}

/// Inscripción de no socios desde la ficha pública del evento (una fila = una entrada)
model EventGuestAttendee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  dni       String
  phone     String?  // obligatorio solo en el titular (primera entrada); acompañantes sin teléfono
  createdAt DateTime @default(now())

  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, dni])
  @@index([eventId])
}

model Attendance {
  id        String   @id @default(cuid())
  status    String   // PRESENT, ABSENT, INJURED, PENDING
  reason    String?  // Reason for absence
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

// --- STORE & PRODUCTS MODELS ---

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Float
  stock       Int      @default(0)
  image       String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  status          String   @default("PENDING") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  totalAmount     Float
  customerName    String
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?  @db.Text
  shippingNotes   String?  @db.Text
  trackingNumber  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  items           OrderItem[]
  invoiceId       String?  @unique
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model TaxConfig {
  id              String   @id @default(cuid())
  isDefault       Boolean  @default(true)
  vatRateIncome   Float    @default(21)
  vatRateExpense  Float    @default(21)
  withholdRateIncome  Float   @default(0)
  withholdRateExpense Float   @default(0)
  applyOnInvoices Boolean  @default(true)
  applyOnIncome   Boolean  @default(true)
  applyOnExpense  Boolean  @default(true)
  applyWithholdOnInvoices Boolean @default(false)
  applyWithholdOnIncome   Boolean @default(false)
  applyWithholdOnExpense  Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([isDefault])
}

model WhatsAppConfig {
  id              String   @id @default(cuid())
  isDefault       Boolean  @default(true)
  linkedSessionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([isDefault])
}

// --- META ADS INTEGRATION MODELS ---

model MetaConfig {
  id            String   @id @default(cuid())
  accessToken   String   @db.Text
  adAccountId   String
  pageId        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MetaCampaign {
  id              String   @id @default(cuid())
  campaignId      String   @unique // ID from Meta Graph API
  name            String
  status          String   // ACTIVE, PAUSED, DELETED, ARCHIVED
  objective       String?
  dailyBudget     Float?
  lifetimeBudget  Float?
  
  // Metrics (cached from Insights API)
  spend           Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  reach           Int      @default(0)
  
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(false)
  priority    String   @default("NORMAL") // HIGH, NORMAL
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

// --- STRIPE BOOTSTRAP (singleton, autogestionado) ---
// Persiste los IDs y secrets de los webhook endpoints creados automáticamente
// por la app contra la cuenta Stripe. Permite que un nuevo despliegue
// (clonado del servicio) se autoconfigure sin tocar variables de entorno
// dedicadas a webhooks.
model StripeBootstrap {
  id                    String   @id @default(cuid())
  isDefault             Boolean  @default(true)
  // URL pública detectada (https://…/api/stripe/webhook) la última vez
  // que se sincronizó con Stripe.
  publicUrl             String?
  // Endpoint "account" (eventos de la plataforma)
  platformWebhookId     String?
  platformWebhookSecret String?  @db.Text
  // Endpoint Connect (eventos de cuentas conectadas / Direct Charges)
  connectWebhookId      String?
  connectWebhookSecret  String?  @db.Text
  // Últimos errores capturados (para depuración desde la UI)
  lastError             String?  @db.Text
  lastSyncedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([isDefault])
}

// --- CLUB IDENTITY & SUBSCRIPTION (singleton) ---
model ClubSettings {
  id               String   @id @default(cuid())
  isDefault        Boolean  @default(true)
  // Identidad
  name             String   @default("Furvoley")
  logoUrl          String?  @db.Text       // data URL (base64) o URL externa
  // Información legal
  legalName        String?
  taxId            String?                  // CIF / NIF / VAT
  address          String?
  city             String?
  postalCode       String?
  province         String?
  country          String?  @default("España")
  contactEmail     String?
  contactPhone     String?
  website          String?
  // Marca
  primaryColor     String?                  // hex (#004ac6, etc.)
  // Plantilla del PDF de facturas (valor: CLASSIC | MODERN | COMPACT)
  invoicePdfTemplate String @default("CLASSIC")
  /** Definición de campos visibles en inscripción (enlace + alta CRM). */
  registrationFieldsConfig Json?
  // NOTA: la configuración de Stripe (customer ID + dashboard URL) vive en
  // variables de entorno (Railway): STRIPE_CLUB_CUSTOMER_ID y STRIPE_DASHBOARD_URL.

  // --- Stripe Connect Express (onboarding desde el CRM) ---
  // El admin del club puede pulsar "Conectar mi cuenta de Stripe" y completar
  // un onboarding hospedado por Stripe. El acct_… se persiste aquí. La env var
  // STRIPE_CONNECTED_ACCOUNT_ID (Railway) sigue siendo válida como override
  // con prioridad máxima. Tipo siempre 'express'.
  stripeConnectedAccountId String?
  stripeAccountType        String?  @default("express")
  stripeChargesEnabled     Boolean? @default(false)
  stripePayoutsEnabled     Boolean? @default(false)
  stripeDetailsSubmitted   Boolean? @default(false)
  stripeAccountStatusAt    DateTime?

  /** API key para Hermes Agent MCP (Bearer). Env HERMES_MCP_API_KEY tiene prioridad. */
  hermesMcpApiKey          String?  @db.Text
  /** Bearer interno para el API Server de Hermes (chat web CRM). Env HERMES_API_SERVER_KEY tiene prioridad. */
  hermesApiServerKey       String?  @db.Text
  hermesEnabled            Boolean  @default(false)
  hermesOllamaApiKey       String?  @db.Text
  hermesOllamaModel        String?  @default("gpt-oss:120b")
  hermesWhatsappMode       String?  @default("bot")
  hermesAllowedUsers       Json?
  hermesAllowDestructive   Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([isDefault])
}

model HermesMcpAuditLog {
  id           String   @id @default(cuid())
  toolName     String
  argsSummary  String   @db.Text
  memberId     String?
  success      Boolean
  errorMessage String?  @db.Text
  source       String   @default("hermes-mcp")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([toolName])
}

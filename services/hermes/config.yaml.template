# Plantilla de config Hermes — sustituye variables al arrancar el contenedor.
# Monta un volumen en /opt/data para persistir sesión WhatsApp Baileys.

mcp_servers:
  furvoley_crm:
    url: "${FURVOLEY_MCP_URL}"
    headers:
      Authorization: "Bearer ${HERMES_MCP_API_KEY}"
    timeout: 180

# DeepSeek (https://api-docs.deepseek.com/quick_start/agent_integrations/hermes)
providers:
  deepseek:
    api_key: "${DEEPSEEK_API_KEY}"
    base_url: "${DEEPSEEK_BASE_URL:-https://api.deepseek.com}"
    model: "${DEEPSEEK_MODEL:-deepseek-chat}"

platforms:
  whatsapp:
    enabled: ${WHATSAPP_ENABLED:-true}
    mode: ${WHATSAPP_MODE:-bot}
    allowed_users:
      - "${WHATSAPP_ALLOWED_USERS}"

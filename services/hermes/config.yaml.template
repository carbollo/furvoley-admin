# Plantilla Hermes (plan B — servicio separado). En contenedor único el CRM genera config.yaml.

model:
  provider: ollama-cloud
  default: "${OLLAMA_MODEL:-gpt-oss:120b}"

mcp_servers:
  furvoley_crm:
    url: "${FURVOLEY_MCP_URL}"
    headers:
      Authorization: "Bearer ${HERMES_MCP_API_KEY}"
    timeout: 180

platforms:
  whatsapp:
    enabled: true
    mode: ${WHATSAPP_MODE:-bot}
    allowed_users:
      - "${WHATSAPP_ALLOWED_USERS}"

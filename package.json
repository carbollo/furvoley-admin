{
  "name": "furvoley",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start-with-db-sync.cjs",
    "start:hermes": "node scripts/start-with-hermes.cjs",
    "bootstrap-admin": "npx tsx prisma/bootstrap-admin.ts",
    "seed": "prisma db seed",
    "lint": "eslint",
    "security:sql": "node scripts/check-no-raw-sql.cjs",
    "postinstall": "prisma generate",
    "cf:prepare": "node scripts/patch-pg-cloudflare.cjs",
    "cf:build": "npm run cf:prepare && opennextjs-cloudflare build",
    "cf:deploy": "npm run cf:prepare && opennextjs-cloudflare deploy",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opennextjs/cloudflare": "^1.19.4",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-auth": "^4.24.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.85.0"
  }
}
